{
  "name": "bskytui",
  "version": "0.0.1",
  "description": "A terminal UI client for Bluesky, built with Ink.",
  "main": "dist/index.js",
  "directories": {
    "doc": "docs"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/masashimachida/bskytui.git"
  },
  "bugs": {
    "url": "https://github.com/masashimachida/bskytui/issues"
  },
  "homepage": "https://github.com/masashimachida/bskytui#readme",
  "scripts": {
    "test": "vitest run",
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "bluesky",
    "atproto",
    "cli",
    "tui",
    "terminal",
    "ink"
  ],
  "author": "mmachida",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@atproto/api": "^0.20.36",
    "@napi-rs/keyring": "^1.3.0",
    "ink": "^7.1.1",
    "ink-picture": "^2.1.0",
    "ink-text-input": "^6.0.0",
    "open": "^11.0.0",
    "react": "^19.2.8",
    "string-width": "^8.2.2",
    "wrap-ansi": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "bin": {
    "bskytui": "dist/index.js"
  },
  "engines": {
    "node": ">=18"
  }
}
